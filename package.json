{
  "name": "@tetherto/swarm-deploy",
  "version": "0.0.0",
  "private": true,
  "description": "Secure resumable artifact uploads over Hyperswarm",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "swarm-deploy": "./dist/bin/swarm-deploy.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "prettier . --check && lunte && npm run test:types",
    "build": "tsc -p tsconfig.json && cp lib/*-node.js dist/ && cp index.d.ts dist/index.d.ts",
    "build:test": "tsc -p tsconfig.test.json",
    "test:types": "tsc --ignoreConfig --noEmit --strict --module node16 --moduleResolution node16 --types node test/types/public-api.ts",
    "test:node": "npm run build && npm run build:test && brittle-node .test-dist/run.js",
    "test:bare": "npm run build && npm run build:test && brittle-bare .test-dist/run.js",
    "test": "npm run test:node && npm run test:bare",
    "prepack": "npm run build && npm run test:types && npm pack --dry-run"
  },
  "imports": {
    "#crypto": {
      "bare": "bare-crypto",
      "default": "./dist/crypto-node.js"
    },
    "#events": {
      "bare": "bare-events",
      "default": "./dist/events-node.js"
    },
    "#fs": {
      "bare": "bare-fs",
      "default": "./dist/fs-node.js"
    },
    "#os": {
      "bare": "bare-os",
      "default": "./dist/os-node.js"
    },
    "#path": {
      "bare": "bare-path",
      "default": "./dist/path-node.js"
    },
    "#process": {
      "bare": "bare-process",
      "default": "./dist/process-node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "NOTICE.md",
    "SECURITY.md"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-crypto": "^1.15.3",
    "bare-events": "^2.9.2",
    "bare-fs": "^4.8.1",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "bare-process": "^4.5.1",
    "compact-encoding": "^3.3.2",
    "hyperdht": "^6.33.2",
    "hyperswarm": "^4.17.0",
    "protomux": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "bare-runtime": "^1.31.0",
    "brittle": "^4.1.0",
    "lunte": "^1.8.4",
    "prettier": "^3.9.6",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
