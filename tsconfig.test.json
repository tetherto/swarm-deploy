{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "test",
    "outDir": ".test-dist",
    "noEmit": false,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["test/run.ts", "test/unit/imports.test.ts"]
}
